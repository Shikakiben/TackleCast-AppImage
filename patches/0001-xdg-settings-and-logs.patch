+/// Resolve an XDG base directory: the environment variable when set, otherwise
+/// the standard location under `$HOME`. Returns `None` when the environment
+/// provides no usable home, which happens in minimal or sandboxed sessions.
+fn xdg_base_dir(variable: &str, home_suffix: &str) -> Option<PathBuf> {
+    non_empty_env(variable).or_else(|| non_empty_env("HOME").map(|home| home.join(home_suffix)))
